{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Skiff",
  "identifier": "com.solutionscay.skiff",
  "build": {
    "beforeDevCommand": "cargo build -p skiffd && pnpm dev",
    "devUrl": "http://127.0.0.1:1421",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Skiff",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Run many coding agents side by side",
    "longDescription": "Skiff groups agent terminals by project and Git worktree. Sessions live in the skiffd daemon and keep running when the window closes.",
    "license": "MIT"
  }
}
